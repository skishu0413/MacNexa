<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd"\>
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>MacNexa</string>
    <key>CFBundleName</key>
    <string>MacNexa</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>
    <!-- Menu-bar agent: no Dock icon, no main window. -->
    <key>LSUIElement</key>
    <true/>
    <!-- Bonjour service for peer discovery (spec §10). -->
    <key>NSBonjourServices</key>
    <array>
        <string>_macnexa._tcp</string>
    </array>
    <key>NSLocalNetworkUsageDescription</key>
    <string>MacNexa uses the local network to discover and coordinate with your other Macs.</string>
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>MacNexa manages the connection of your Magic Keyboard and Magic Trackpad.</string>
</dict>
</plist>
